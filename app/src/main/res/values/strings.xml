    <string name="accessibility_label">CallScribe — call watcher</string>
    <string name="accessibility_description">Lets CallScribe detect when a phone call starts and ends so it can start recording. It does not read screen content.</string>

    <!-- Navigation -->
    <string name="tab_table">Table</string>
    <string name="tab_sources">Sources</string>
    <string name="tab_settings">Settings</string>

    <!-- Consent -->
    <string name="consent_intro">The app records phone calls and reads messages, turns them into text, and pulls out tasks with deadlines into a table of reminders.</string>
    <string name="consent_heading">Read this before you continue:</string>
    <string name="consent_legal">Recording a call without the other party knowing is illegal in many countries. Responsibility is yours.</string>
    <string name="consent_audio">Since Android 10 the system gives no access to the other party\'s audio. On most phones the recording goes through the microphone — the other side is only audible on speakerphone.</string>
    <string name="consent_network">Transcription and analysis are sent to the server you configure. The content of your calls leaves the phone. If that is not acceptable, use a local transcription server.</string>
    <string name="consent_storage">Recordings and text stay on this phone only, in the app\'s private storage.</string>
    <string name="consent_store">The app cannot be published on Google Play — the rules forbid call recording and SMS access for apps that are not the default SMS handler.</string>
    <string name="consent_checkbox">I understand the requirements and take responsibility for lawful use.</string>
    <string name="consent_continue">Understood, continue</string>

